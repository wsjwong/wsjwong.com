---
import { SITE_TITLE } from "../consts";

const baseUrl = import.meta.env.BASE_URL;
const basePath = baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl;
---

<div id="sidebar">
  <div id="nav-wrapper">
    <div id="profile-wrapper" class="d-flex flex-column">
      <div id="avatar" class="d-flex justify-content-center">
        <a href={baseUrl}>
          <img src={`${baseUrl}peter-avatar.jpg`} alt="Joe Wong" />
        </a>
      </div>
      <div class="profile-text mt-3">
        <div id="site-title">
          <a href={baseUrl}>{SITE_TITLE}</a>
        </div>
        <div id="site-subtitle" class="font-italic">
          Building products, sharing notes, and shipping in public.
        </div>
      </div>
    </div>

    <ul class="nav flex-column">
      <li class="nav-item">
        <a href={baseUrl} class="nav-link">
          <i class="fa-fw fas fa-home"></i>
          <span>HOME</span>
        </a>
      </li>
      <li class="nav-item">
        <a href={`${baseUrl}posts`} class="nav-link">
          <i class="fa-fw fas fa-pen-nib"></i>
          <span>BLOG</span>
        </a>
      </li>
      <li class="nav-item">
        <a href={`${baseUrl}about`} class="nav-link">
          <i class="fa-fw fas fa-info"></i>
          <span>ABOUT</span>
        </a>
      </li>
    </ul>
  </div>

  <div class="sidebar-bottom">
    <div class="social-links">
      <a href="https://github.com/wsjwong" target="_blank" rel="noopener noreferrer">
        <i class="fab fa-github-alt"></i>
      </a>
      <a href="https://www.linkedin.com/in/wsjwong/" target="_blank" rel="noopener noreferrer">
        <i class="fab fa-linkedin"></i>
      </a>
      <a href={`${baseUrl}rss.xml`} target="_blank" rel="noopener noreferrer">
        <i class="fas fa-rss"></i>
      </a>
    </div>
  </div>
</div>

<script is:inline>
  // Add active class to current page (GitHub Pages base-path aware)
  const basePath = {JSON.stringify(basePath)};

  document.addEventListener("DOMContentLoaded", () => {
    const rawPath = window.location.pathname;
    const currentPath = rawPath.startsWith(basePath)
      ? rawPath.slice(basePath.length) || "/"
      : rawPath;

    const navLinks = document.querySelectorAll(".nav-link");

    navLinks.forEach((link) => {
      const href = link.getAttribute("href");
      if (!href) return;

      // hrefs here already include baseUrl (e.g. /wsjwong.com/posts)
      const normalizedHref = href.startsWith(basePath)
        ? href.slice(basePath.length) || "/"
        : href;

      if (normalizedHref === "/" && currentPath === "/") {
        link.classList.add("active");
      } else if (normalizedHref !== "/" && currentPath.startsWith(normalizedHref)) {
        link.classList.add("active");
      }
    });
  });
</script>

<!-- Load FontAwesome -->
<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css"
/>
