---
export interface Props {
  variant?: "default" | "compact";
}

const { variant = "default" } = Astro.props;
---

<div class={variant === 'default' ? 'newsletter-box bg-gray-50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 rounded-lg p-6 my-8' : 'newsletter-compact mt-6'}>
  {variant === 'default' && (
    <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
      New posts, shipping stories, and nerdy links straight to your inbox.
    </p>
  )}
  
  <form
    data-newsletter-form
    action="/api/subscribe"
    method="post"
    class="flex flex-col sm:flex-row gap-3"
  >
    <input type="hidden" name="path" value={Astro.url.pathname} />
    <input
      type="email"
      name="email"
      placeholder="Your Email"
      required
      class="flex-1 px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent"
    />
    <button
      type="submit"
      class="px-6 py-2 bg-accent rounded-md hover:bg-accent/90 transition-colors font-medium whitespace-nowrap focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2"
      style="color: white;"
    >
      Subscribe
    </button>
  </form>

  <p
    data-newsletter-message
    class="text-sm mt-3 hidden text-gray-600 dark:text-gray-400"
    aria-live="polite"
  />
  
  {variant === 'default' && (
    <p class="text-xs text-gray-500 dark:text-gray-400 mt-3">
      2× per month, pure signal, zero fluff.
    </p>
  )}
</div>

<script is:inline>
  (() => {
    const forms = document.querySelectorAll("form[data-newsletter-form]");
    for (const form of forms) {
      const messageEl = form.parentElement?.querySelector("[data-newsletter-message]");
      const submitButton = form.querySelector("button[type='submit']");
      if (!(form instanceof HTMLFormElement) || !(messageEl instanceof HTMLElement) || !(submitButton instanceof HTMLButtonElement)) continue;

      const setMessage = (text, tone) => {
        messageEl.textContent = text;
        messageEl.dataset.tone = tone;
        messageEl.classList.remove("hidden");
      };

      const url = new URL(window.location.href);
      const subscribed = url.searchParams.get("subscribed");
      const subscribeError = url.searchParams.get("subscribe_error");
      if (subscribed === "1") {
        setMessage("You’re subscribed. Check your inbox for a confirmation email.", "success");
        url.searchParams.delete("subscribed");
        history.replaceState({}, "", url.toString());
      } else if (subscribeError) {
        const errorText =
          subscribeError === "invalid_email"
            ? "Please enter a valid email address."
            : subscribeError === "db_not_configured"
              ? "Subscription is temporarily unavailable. Please try again later."
              : "Something went wrong. Please try again.";
        setMessage(errorText, "error");
        url.searchParams.delete("subscribe_error");
        history.replaceState({}, "", url.toString());
      }

      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        const formData = new FormData(form);
        const email = formData.get("email");
        const path = formData.get("path") || window.location.pathname;
        if (typeof email !== "string" || email.trim().length < 3) {
          setMessage("Please enter a valid email address.", "error");
          return;
        }

        submitButton.disabled = true;
        const originalText = submitButton.textContent || "Subscribe";
        submitButton.textContent = "Subscribing...";
        setMessage("Working…", "info");

        try {
          const res = await fetch("/api/subscribe", {
            method: "POST",
            headers: {
              "content-type": "application/json",
              accept: "application/json",
            },
            body: JSON.stringify({ email, path }),
          });

          const data = await res.json().catch(() => ({}));
          if (!res.ok || data?.ok === false) {
            setMessage(data?.error || "Something went wrong. Please try again.", "error");
            return;
          }

          setMessage("You’re subscribed. Check your inbox for a confirmation email.", "success");
          form.reset();
        } catch {
          setMessage("Network error. Please try again.", "error");
        } finally {
          submitButton.disabled = false;
          submitButton.textContent = originalText;
        }
      });
    }
  })();
</script>

<style>
  [data-newsletter-message][data-tone="success"] {
    color: rgb(21 128 61); /* roughly tailwind text-green-700 */
  }
  .dark [data-newsletter-message][data-tone="success"] {
    color: rgb(134 239 172); /* roughly tailwind text-green-300 */
  }
  [data-newsletter-message][data-tone="error"] {
    color: rgb(185 28 28); /* roughly tailwind text-red-700 */
  }
  .dark [data-newsletter-message][data-tone="error"] {
    color: rgb(252 165 165); /* roughly tailwind text-red-300 */
  }

  @media (max-width: 640px) {
    .newsletter-box {
      margin-left: -1rem;
      margin-right: -1rem;
      border-radius: 0;
    }
  }
</style>
