---
import { SITE } from "@/config";

export interface Props {
  variant?: "default" | "compact";
}

const { variant = "default" } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<div
  class={
    variant === "default"
      ? "newsletter-box bg-gray-50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 rounded-lg p-6 my-8"
      : "newsletter-compact mt-6"
  }
>
  <p class="text-sm text-gray-600 dark:text-gray-400 mb-2">
    Get new posts via RSS.
  </p>
  <a
    href={`${baseUrl}rss.xml`}
    class="inline-block text-accent underline"
    aria-label={`${SITE.title} RSS feed`}
  >
    {SITE.title} RSS Feed
  </a>
</div>

<style>
  @media (max-width: 640px) {
    .newsletter-box {
      margin-left: -1rem;
      margin-right: -1rem;
      border-radius: 0;
    }
  }
</style>
